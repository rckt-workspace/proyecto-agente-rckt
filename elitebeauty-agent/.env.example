TWILIO_VALIDATE_SIGNATURE=false

# ─── URLs ─────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://agent.elitebeauty.com.co
WA_BRIDGE_URL=http://wa_bridge:3001

# ─── App ──────────────────────────────────────────────────────────────────────
