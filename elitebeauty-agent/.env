# ─── LLM Router ───────────────────────────────────────────────────────────────
# Proveedor activo por defecto (si agent_config no define otro)
LLM_PROVIDER=anthropic

# Proveedor de último recurso si falla el primario completo
CHAT_FALLBACK_PROVIDER=anthropic

# Flags del pipeline (sobreescribibles desde agent_config en Supabase)
CHAT_USE_FALLBACK=true
CHAT_USE_ENHANCEMENT=false
CHAT_USE_JUDGE=false

# Parámetros LLM
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.8
CHAT_MAX_TOKENS=900
CHAT_TIMEOUT_MS=45000
CHAT_FALLBACK_TIMEOUT_MS=45000
CHAT_ENHANCEMENT_TIMEOUT_MS=30000
CHAT_JUDGE_TIMEOUT_MS=20000

# ─── OpenRouter ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Modelos OpenRouter por rol
OPENROUTER_PRIMARY_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_ENHANCEMENT_MODEL=openrouter/free
OPENROUTER_JUDGE_MODEL=openrouter/free

YOUR_SITE_URL=https://elitebeauty.com.co
YOUR_SITE_NAME=Elite Beauty Agent

# ─── Anthropic / Claude directo ───────────────────────────────────────────────
ANTHROPIC_API_KEY=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
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Modelos Anthropic por rol
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_PRIMARY_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
ANTHROPIC_ENHANCEMENT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001

# ─── Embeddings RAG (independiente del LLM de chat) ──────────────────────────
# Proveedores: local | openrouter | openai
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# OpenAI — opcional, solo si EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=sk-...

