OLLAMA_URL=http://localhost:11434
# En esta maquina ya existe llama3.2:latest. Si instalas llama3 exacto,
# puedes cambiar esto a OLLAMA_MODEL=llama3.
OLLAMA_MODEL=llama3.2:latest
BOT_PORT=3001

# Numero que recibe los mensajes del boton del Home.
# Para Colombia usa 57 + celular, sin + ni espacios.
BOT_PUBLIC_NUMBER=573153863179
BOT_OWNER_NUMBER=573153863179

# false = responde a cualquier persona que escriba al WhatsApp conectado.
# true = solo responde a contactos en bot/data/authorized.json.
BOT_REQUIRE_AUTH=false

BOT_DATA_DIR=./data
WA_SESSION_DIR=./bot-session
COOLDOWN_MS=2000
